---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pubDate?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  type = 'website',
  pubDate,
} = Astro.props;

const siteUrl = 'https://llm-ads.de';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title === 'ChatGPT Ads Agentur' ? title : `${title} | ChatGPT Ads Agentur`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ChatGPT Ads Agentur" />
    <meta property="og:locale" content="de_DE" />
    {pubDate && <meta property="article:published_time" content={pubDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? "Article" : "ProfessionalService",
      "name": "ChatGPT Ads Agentur",
      "url": siteUrl,
      "description": "Wir sorgen dafür, dass dein Unternehmen in den Antworten von ChatGPT, Gemini und Co. auftaucht.",
      "areaServed": "DE",
      "availableLanguage": "Deutsch",
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="logo">ChatGPT Ads Agentur</a>
        <div class="nav-links">
          <a href="/#was-wir-machen">Leistungen</a>
          <a href="/#wie-es-funktioniert">So funktioniert's</a>
        </div>
        <a href="/#gespraech" class="btn-nav">Kostenloses Erstgespräch</a>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="container">
        <span>© {new Date().getFullYear()} ChatGPT Ads Agentur</span>
        <div class="footer-links">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
      </div>
    </footer>
  </body>
</html>
