---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Danke für deine Anfrage"
  description="Wir melden uns innerhalb von 24 Stunden bei dir."
>
  <section style="padding: 8rem 2rem; text-align: center;">
    <div class="container narrow center">
      <p class="eyebrow">ANFRAGE ERHALTEN</p>
      <h1 style="font-size: clamp(1.75rem, 3vw, 2.5rem);">Danke – wir melden uns bald.</h1>
      <p style="margin-bottom: 2rem;">Wir haben deine Anfrage erhalten und melden uns innerhalb von 24 Stunden bei dir. Unverbindlich, ehrlich, ohne Verkaufsdruck.</p>
      <a href="/" class="btn-primary">Zurück zur Startseite</a>
    </div>
  </section>
</Layout>
