---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog – KI-Marketing & GEO Insights"
  description="Aktuelle Einblicke zu Generative Engine Optimization, ChatGPT Ads und KI-Sichtbarkeit für Unternehmen."
>
  <section class="blog-index">
    <div class="container">
      <div class="blog-header">
        <p class="eyebrow">BLOG</p>
        <h1>KI-Marketing & GEO Insights</h1>
        <p>Aktuelle Einblicke zu Generative Engine Optimization, ChatGPT Ads und KI-Sichtbarkeit.</p>
      </div>
      <div class="post-grid">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="post-card-body">
              <p class="post-date">{post.data.pubDate.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</p>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
            <div class="post-card-footer">Artikel lesen →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
